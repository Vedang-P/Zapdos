# Render-only image: realtime server + background workers + local Redis.
# The Next.js frontend is deployed separately on Vercel, so this image skips
# `next build` entirely and only needs the TypeScript source + workspace deps.

FROM node:20-slim AS base
RUN corepack enable && corepack prepare pnpm@9.7.1 --activate

FROM base AS deps
WORKDIR /app
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/db/package.json ./packages/db/
COPY packages/elo/package.json ./packages/elo/
COPY packages/judge/package.json ./packages/judge/
COPY packages/match/package.json ./packages/match/
COPY packages/realtime/package.json ./packages/realtime/
RUN pnpm install --frozen-lockfile

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates redis-server \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable && corepack prepare pnpm@9.7.1 --activate

COPY --chown=node:node --from=deps /app/node_modules ./node_modules
COPY --chown=node:node --from=deps /app/apps/web/node_modules ./apps/web/node_modules
COPY --chown=node:node --from=deps /app/packages/db/node_modules ./packages/db/node_modules
COPY --chown=node:node --from=deps /app/packages/elo/node_modules ./packages/elo/node_modules
COPY --chown=node:node --from=deps /app/packages/judge/node_modules ./packages/judge/node_modules
COPY --chown=node:node --from=deps /app/packages/match/node_modules ./packages/match/node_modules
COPY --chown=node:node --from=deps /app/packages/realtime/node_modules ./packages/realtime/node_modules
COPY --chown=node:node . .

RUN pnpm db:generate

EXPOSE 10000
USER node

CMD ["bash", "deploy/start-render.sh"]
