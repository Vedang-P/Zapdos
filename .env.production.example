# ============================================================
# Zapdos — production environment variables (split deployment)
#
#   Public:   Cloudflare Worker -> Vercel Next.js
#                                -> Render realtime/workers
#   Database: Neon Postgres (Vercel Marketplace)
#
# Values below are split by service. NEVER commit real secrets.
# ============================================================

# ------------------------------------------------------------
# Vercel (apps/web)
# ------------------------------------------------------------
APP_URL=https://zapdos.vedangpandeyy.workers.dev
NODE_ENV=production
# Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# Neon pooled connection string (host contains "-pooler").
# Use the unpooled URL only for `prisma migrate deploy`.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/zapdos?sslmode=require&pgbouncer=true

# NextAuth
NEXTAUTH_URL=https://zapdos.vedangpandeyy.workers.dev
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# Render realtime service (public HTTPS URL; the web app calls its HMAC bridge)
REALTIME_URL=https://zapdos-realtime.onrender.com
REALTIME_CORS_ORIGIN=https://zapdos.vedangpandeyy.workers.dev

# Leave NEXT_PUBLIC_REALTIME_URL unset in production: the browser connects to
# window.location.origin/socket.io, and the Cloudflare Worker proxies it to
# Render. Setting it to the Render URL would expose the origin and bypass the
# Worker's WebSocket proxy.

# Judge: Vercel Sandbox (Hobby: 5 CPU-hours/month, 10 concurrent)
JUDGE_BACKEND=sandbox
JUDGE_SANDBOX_SNAPSHOT_ID=snap_replace_me
JUDGE_SANDBOX_REGION=iad1
JUDGE_SANDBOX_MAX_CONCURRENT=6
# Judge0 is only a local/fallback backend now.
# JUDGE0_URL=http://localhost:2358
# JUDGE0_API_KEY=

# ------------------------------------------------------------
# Render (realtime + matchmaker + finalizer + bot + local Redis)
# ------------------------------------------------------------
# Same Neon database as Vercel.
# DATABASE_URL=...
NODE_ENV=production
AUTH_SECRET=change-me-to-a-long-random-string
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# The start script defaults these to loopback; Render provides PORT=10000.
# REDIS_URL=redis://127.0.0.1:6379
# REALTIME_URL=http://127.0.0.1:10000
# REALTIME_CORS_ORIGIN=https://zapdos.vedangpandeyy.workers.dev

# Bot opponent (optional; these are the defaults)
BOT_EMAIL=zap-bot@zapdos.dev
BOT_USERNAME=Zapdos-Bot

# ------------------------------------------------------------
# Local-only helper: creating the Vercel Sandbox snapshot
# ------------------------------------------------------------
# Run `vercel env pull` after linking the project, or export these:
# VERCEL_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_PROJECT_ID=
