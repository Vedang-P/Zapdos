# ============================================================
# Zapdos — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- App ---
# Base URL of the Next.js app (used for auth callbacks, links, CORS).
APP_URL=http://localhost:3000
NODE_ENV=development
# Random 32+ char string. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string

# --- Database (Postgres) ---
# Matches docker-compose.yml. For local dev you usually leave these as-is.
DATABASE_URL=postgresql://zapdos:zapdos_local@localhost:5432/zapdos?schema=public

# --- Redis ---
# Used for matchmaking queue, ephemeral live match state, and Socket.IO scaling.
# Include password in URL: redis://:password@host:port
REDIS_URL=redis://:zapdos_redis_pass@localhost:6379

# --- Judge backend ---
# judge0  (default): Judge0 CE at http://localhost:2358 (Docker).
# sandbox (prod):    Vercel Sandbox, using a snapshot built by
#                    `pnpm --filter @zapdos/judge snapshot`.
# local   (dev/CI):  compile + run with the g++ / python3 / javac installed on this machine.
#                    No isolation - never use for untrusted code. See docs/judge-backends.md.
JUDGE_BACKEND=judge0
# Optional overrides for the local backend's toolchain binaries.
# LOCAL_JUDGE_GPP=g++
# LOCAL_JUDGE_PYTHON=python3
# LOCAL_JUDGE_JAVAC=javac
# LOCAL_JUDGE_JAVA=java

# --- AST anti-cheat (see docs/anticheat.md) ---
# ANTICHEAT_ENABLED=true
# Flag two accepted submissions whose normalised ASTs are at least this similar (0-1).
# ANTICHEAT_SIMILARITY_THRESHOLD=0.85
# Time budget (ms) for the post-AC similarity search; findings are skipped, never blocking, when exceeded.
# ANTICHEAT_BUDGET_MS=1500
# Directory with tree-sitter-{cpp,python,java}.wasm if they cannot be found automatically.
# ANTICHEAT_WASM_DIR=
JUDGE0_URL=http://localhost:2358
# Required only when JUDGE_BACKEND=judge0 with a hosted Judge0.
JUDGE0_API_KEY=
# Max concurrent judge jobs per process.
JUDGE_CONCURRENCY=4
# Vercel Sandbox backend (JUDGE_BACKEND=sandbox)
JUDGE_SANDBOX_SNAPSHOT_ID=
JUDGE_SANDBOX_REGION=iad1
JUDGE_SANDBOX_MAX_CONCURRENT=6

# --- Auth (NextAuth) ---
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-me-to-a-long-random-string

# --- Google OAuth (optional) ---
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Match rules ---
# Battle duration in seconds (default 20 minutes).
MATCH_DURATION_SECONDS=1200
# Wrong-submission penalty, applied to per-problem score (floor 0).
WRONG_SUBMISSION_PENALTY=10
# ELO provisional-game threshold; K=K_PROVISIONAL until gamesPlayed >= this.
ELO_PROVISIONAL_GAMES=10
ELO_K_PROVISIONAL=40
ELO_K_ESTABLISHED=32
ELO_DEFAULT=1200

# --- Realtime (Socket.IO) ---
# Origin allowed for CORS on the realtime server.
REALTIME_CORS_ORIGIN=http://localhost:3000
# Internal URL the Next.js API routes use to POST /emit to the realtime server.
REALTIME_URL=http://localhost:3002
# Public URL the browser uses to open the Socket.IO connection.
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
NEXT_PUBLIC_REALTIME_URL=http://localhost:3002

# --- Recommender (see docs/recommender.md) ---
# Optional: explain recommendations with an OpenAI-compatible chat endpoint. The model is only shown the retrieved
# problems and its output is validated; without these a deterministic template writes the rationale.
# RECOMMENDER_LLM_URL=https://api.openai.com/v1/chat/completions
# RECOMMENDER_LLM_API_KEY=
# RECOMMENDER_LLM_MODEL=gpt-4o-mini
# Cache problem embeddings in Redis so a cold serverless instance does not re-read every statement.
# RECOMMENDER_REDIS_CACHE=1
